<Window x:Class="PhotoRepairInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoRepairInspector"
        mc:Ignorable="d"
        Title="Windows Photo Repair Inspector" Height="720" Width="1200">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="DataGridRow">
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#40F0F8FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" Background="#FF1E1E1E">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Scan folder..." Command="{Binding ScanFolderCommand}" Padding="12,6" />
                <TextBlock Foreground="White" VerticalAlignment="Center" Text="Problem date:" Margin="12,0,4,0" />
                <DatePicker SelectedDate="{Binding Configuration.ProblemDate, Mode=TwoWay}" Width="140" />
                <TextBlock Foreground="White" VerticalAlignment="Center" Text="Tolerance (days):" Margin="12,0,4,0" />
                <TextBox Width="40" Text="{Binding Configuration.ProblemDateToleranceDays, Mode=TwoWay}" />
                <CheckBox Content="Auto-group by parsed date" IsChecked="{Binding Configuration.AutoGroupByParsedDate}" Foreground="White" Margin="12,0,0,0" />
                <CheckBox Content="Show only items with changes" IsChecked="{Binding ShowOnlyWithChanges}" Foreground="White" Margin="12,0,0,0" />
                <CheckBox Content="Move deleted files to Recovered_Deleted" IsChecked="{Binding Configuration.MoveInsteadOfDelete}" Foreground="White" Margin="12,0,0,0" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>
            <TabControl Grid.Column="0" Grid.RowSpan="2" Margin="8" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="All files">
                    <DataGrid ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="False" Margin="0" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Action" SelectedValueBinding="{Binding SelectedActionType, Mode=TwoWay}" SelectedValuePath="Action" DisplayMemberPath="Description" Width="190">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <Binding Path="DataContext.ActionChoices" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTemplateColumn Header="Preview" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="48" Height="48" Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="200" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding DirectoryName}" Width="200" />
                            <DataGridTextColumn Header="Parsed date" Binding="{Binding ParsedDateDisplay}" Width="150" />
                            <DataGridTextColumn Header="Current file date (created)" Binding="{Binding CreatedDisplay}" Width="180" />
                            <DataGridTextColumn Header="Current file date (modified)" Binding="{Binding ModifiedDisplay}" Width="180" />
                            <DataGridTextColumn Header="New date (preview)" Binding="{Binding ProposedDateDisplay}" Width="180" />
                            <DataGridTextColumn Header="Size (KB)" Binding="{Binding SizeDisplay}" Width="100" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120" />
                            <DataGridTextColumn Header="Group key" Binding="{Binding GroupKey}" Width="170" />
                            <DataGridTextColumn Header="Notes / Warning" Binding="{Binding Notes}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Suspicious groups">
                    <ListView ItemsSource="{Binding SuspiciousGroups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" Margin="4">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Group key" DisplayMemberBinding="{Binding GroupKey}" Width="180" />
                                <GridViewColumn Header="Summary" DisplayMemberBinding="{Binding Summary}" Width="300" />
                                <GridViewColumn Header="Items" DisplayMemberBinding="{Binding ItemCount}" Width="80" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
            <Border Grid.Column="1" Grid.Row="0" Margin="8" Padding="12" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Preview" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />
                        <Border BorderBrush="#FFDDDDDD" BorderThickness="1" Padding="8" CornerRadius="4">
                            <StackPanel>
                                <Image Source="{Binding SelectedItem.PreviewImage}" Height="220" Stretch="Uniform" Visibility="{Binding SelectedItem.IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedItem.IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Video" FontWeight="Bold" />
                                    <TextBlock Text=" - " />
                                    <TextBlock Text="{Binding SelectedItem.FileName}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedItem.FullPath}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Resolution:" FontWeight="Bold" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding SelectedItem.Resolution}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Size:" FontWeight="Bold" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding SelectedItem.SizeDisplay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Change Preview" FontWeight="Bold" FontSize="16" Margin="0,20,0,12" />
                        <Border BorderBrush="#FFDDDDDD" BorderThickness="1" Padding="8" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedItem.PlannedAction}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.ActionReason}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Current Created:" FontWeight="Bold" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding SelectedItem.CreatedDisplay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Current Modified:" FontWeight="Bold" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding SelectedItem.ModifiedDisplay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="New Date:" FontWeight="Bold" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding SelectedItem.ProposedDateDisplay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EXIF:" FontWeight="Bold" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding SelectedItem.ExifStatus}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedItem.DuplicateSummary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
                                    <Button Content="Apply to this file only" Command="{Binding ApplySingleCommand}" CommandParameter="{Binding SelectedItem}" />
                                    <Button Content="Ignore this file" Command="{Binding IgnoreSingleCommand}" CommandParameter="{Binding SelectedItem}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Grid.Row="1" Margin="8" Padding="12" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Log" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                    <TextBox Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Height="180" />
                    <Button Content="Apply selected changes" Command="{Binding ApplySelectedCommand}" Margin="0,12,0,0" Padding="12,6" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
