<Window x:Class="PhotoRepairInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Photo Date Fixer" Height="720" Width="1100">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12" Background="#FF1E1E1E">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="Scan folder..." Command="{Binding ScanFolderCommand}" Padding="12,6" />
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="Problem date:" Margin="16,0,4,0" />
                    <DatePicker SelectedDate="{Binding Configuration.ProblemDate, Mode=TwoWay}" Width="160" />
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="Tolerance (days):" Margin="16,0,4,0" />
                    <TextBox Width="48"
                             Text="{Binding Configuration.ProblemDateToleranceDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Foreground="White" FontWeight="Bold" Margin="16,0,0,0"
                               Text="{Binding PendingFixCount, StringFormat=Pending fixes: {0}}" />
                    <TextBlock Foreground="White" Margin="12,0,0,0"
                               Text="{Binding TotalItems, StringFormat=Files scanned: {0}}" />
                    <TextBlock Foreground="LightGreen" FontWeight="Bold" Margin="16,0,0,0"
                               Text="Scanning..."
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <TextBlock Foreground="WhiteSmoke"
                           Text="Only files that match the selected problem date range appear below. Uncheck any you want to skip, then click Apply date fixes."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Fix?" Binding="{Binding IsSelected, Mode=TwoWay}" Width="60" />
                    <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="200" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding DirectoryName}" Width="280" />
                    <DataGridTextColumn Header="Current created" Binding="{Binding CreatedDisplay}" Width="160" />
                    <DataGridTextColumn Header="Current modified" Binding="{Binding ModifiedDisplay}" Width="160" />
                    <DataGridTextColumn Header="New date" Binding="{Binding ProposedDateDisplay}" Width="150" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="200" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
                <Button Content="Apply date fixes"
                        Command="{Binding ApplyFixesCommand}"
                        Padding="16,8" />
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Text="Changes are written immediately when you apply fixes. A log file is saved in the scanned folder." />
            </StackPanel>
            <Border Grid.Row="2" Padding="8" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock Text="Log" FontWeight="Bold" Margin="0,0,0,8" DockPanel.Dock="Top" />
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
